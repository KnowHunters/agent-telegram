# Generate independent random values. Do not reuse them.
GATEWAY_HOST_PORT=18080
AGENT_TELEGRAM_PROFILE=default
# Generate with: openssl rand -hex 32
AGENT_TELEGRAM_API_SECRET=replace-with-a-random-gateway-token
# Create an app at https://my.telegram.org. The built-in public API ID can be
# rejected with API_ID_PUBLISHED_FLOOD.
TELEGRAM_APP_ID=replace-with-your-telegram-app-id
TELEGRAM_APP_HASH=replace-with-your-telegram-app-hash
